# Database Configuration
# For local development:
DATABASE_URL=file:workshop.db

# For Railway deployment with persistent volume:
# DATABASE_URL=file:/data/workshop.db

# OpenRouter API Key (required for AI Debrief feature)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model slug to use (see https://openrouter.ai/models for the exact string)
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Optional: your deployed app URL, sent as the HTTP-Referer header to OpenRouter
APP_URL=https://dsoea-workshop-app.up.railway.app
